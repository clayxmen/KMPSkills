{
  "name": "kmp-skills",
  "version": "1.0.0",
  "description": "Production-grade AI skills, architectural rules, and context generator for Android Native & Kotlin Multiplatform projects.",
  "keywords": [
    "kmp",
    "kotlin-multiplatform",
    "android",
    "compose-multiplatform",
    "cursor-rules",
    "copilot-instructions",
    "antigravity",
    "ai-coding-assistant",
    "mvi",
    "room-kmp",
    "ktor"
  ],
  "author": "clayxmen",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "kmp-skills": "./bin/kmp-skills.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.vi.md"
  ],
  "scripts": {
    "build:skills": "node scripts/generate-skills-data.mjs",
    "build:curriculum": "node scripts/generate-curriculum-data.mjs",
    "build:data": "npm run build:skills && npm run build:curriculum",
    "build": "npm run build:data && tsc",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
